{
  "name": "temp-car-shop",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test test:e2e",
    "dev": "turbo run dev",
    "dev:client": "pnpm --filter @carshop/mobile-client dev",
    "dev:admin": "pnpm --filter @carshop/mobile dev",
    "start:api": "pnpm --filter @carshop/api start",
    "start:web": "pnpm --filter @carshop/web start",
    "start": "concurrently \"pnpm start:api\" \"pnpm start:web\"",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "prettier": "^3.7.4",
    "turbo": "^2.9.18",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@carshop/schema": "workspace:^"
  }
}
