// packages/db/prisma/schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  CUSTOMER
  SALES_REP
  ADMIN
}

enum VehicleStatus {
  AVAILABLE
  PENDING_RESERVATION
  RESERVED
  SOLD
  IN_TRANSIT
  MAINTENANCE
}

enum OrderStatus {
  PENDING_GATEWAY
  DEPOSIT_SECURED
  FINANCING_APPROVED
  COMPLETED
  CANCELLED
  GATEWAY_REJECTED
  REFUNDED
}

model User {
  id           String             @id @default(uuid())
  email        String             @unique
  passwordHash String
  role         UserRole           @default(CUSTOMER)
  firstName    String
  lastName     String
  phone        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  orders       ReservationOrder[]

  @@index([email])
}

model DealershipLocation {
  id          String             @id @default(uuid())
  code        String             @unique
  name        String
  address     String
  city        String
  country     String             @default("Morocco")
  phone       String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  inventory   VehicleInventory[]

  @@index([code])
  @@index([city])
}

model VehicleInventory {
  id                   String             @id @default(uuid())
  vin                  String             @unique @db.VarChar(17)
  make                 String
  model                String
  year                 Int
  trim                 String?
  price                Decimal            @db.Decimal(12, 2)
  mileage              Int                @default(0)
  exteriorColor        String
  imageUrl             String?
  status               VehicleStatus      @default(AVAILABLE)
  dealershipLocationId String

  location             DealershipLocation @relation(fields: [dealershipLocationId], references: [id])
  orders               ReservationOrder[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([vin])
  @@index([status, make, model])
  @@index([dealershipLocationId])
}

model ReservationOrder {
  id            String           @id @default(uuid())
  orderNumber   String           @unique
  userId        String
  vehicleId     String
  status        OrderStatus      @default(PENDING_GATEWAY)
  depositAmount Decimal          @db.Decimal(10, 2)
  finalPrice    Decimal          @db.Decimal(12, 2)
  intentToken   String           @unique
  expiresAt     DateTime       
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user          User             @relation(fields: [userId], references: [id])
  vehicle       VehicleInventory @relation(fields: [vehicleId], references: [id])

  @@index([orderNumber])
  @@index([intentToken])
  @@index([userId, status])
  @@index([vehicleId, status])
}
